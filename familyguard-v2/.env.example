# FamilyGuard 2.0 - Environment Configuration

# Application
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
CORS_ORIGIN=*

# Security & Authentication
JWT_SECRET=replace_with_a_secure_random_string_in_production_min_32_chars
JWT_EXPIRES_IN=7d

# Database (PostgreSQL)
DATABASE_URL="postgresql://familyguard:familyguard_secret_change_me@postgres:5432/familyguard_v2?schema=public"

# Redis Cache & BullMQ
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# Firebase Cloud Messaging (FCM)
FIREBASE_PROJECT_ID=familyguard-v2
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# SaaS & Billing (Future Phase)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
