<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B0F19"
    android:clickable="true"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="24dp">

        <!-- Banner de Modo de Prueba (Visible únicamente al presionar Probar Bloqueo) -->
        <LinearLayout
            android:id="@+id/ll_test_banner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#D97706"
            android:padding="12dp"
            android:layout_marginBottom="20dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/tv_test_countdown"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🧪 MODO DE PRUEBA ACTIVO (Auto-cierre en 10s)"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold"
                android:gravity="center"
                android:layout_marginBottom="8dp" />

            <Button
                android:id="@+id/btn_exit_test"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="✕ CERRAR PRUEBA Y VOLVER"
                android:backgroundTint="#000000"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_overlay_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔒"
            android:textSize="64sp"
            android:layout_marginBottom="12dp" />

        <TextView
            android:id="@+id/tv_overlay_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Dispositivo Pausado"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tv_overlay_desc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tus padres han activado la pausa instantánea o se ha alcanzado el límite de tiempo.\nEl acceso a las aplicaciones está temporalmente restringido."
            android:textColor="#94A3B8"
            android:textSize="13sp"
            android:gravity="center"
            android:lineSpacingExtra="3dp"
            android:layout_marginBottom="24dp" />

        <!-- Botón para pedir más tiempo a los padres -->
        <Button
            android:id="@+id/btn_overlay_ask"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Pedir autorización a mis padres"
            android:backgroundTint="#FFB800"
            android:textColor="#000000"
            android:textStyle="bold"
            android:layout_marginBottom="10dp" />

        <!-- Botón de Llamada de Emergencia -->
        <Button
            android:id="@+id/btn_emergency_call"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Llamada de Emergencia"
            android:backgroundTint="#1E293B"
            android:textColor="#E2E8F0"
            android:layout_marginBottom="16dp" />

        <!-- Sección de Desbloqueo con PIN de Padres -->
        <Button
            android:id="@+id/btn_parent_pin_toggle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🔑 Desbloquear con PIN de Padres"
            android:backgroundTint="#0F172A"
            android:textColor="#38BDF8"
            android:textSize="12sp"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:id="@+id/ll_pin_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#161F30"
            android:padding="14dp"
            android:layout_marginBottom="16dp"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Ingresa el PIN de Padres (1234 o tu código familiar):"
                android:textColor="#CBD5E1"
                android:textSize="11sp"
                android:layout_marginBottom="6dp" />

            <EditText
                android:id="@+id/et_parent_pin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#0B0F19"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:padding="10dp"
                android:inputType="numberPassword"
                android:hint="PIN: 1234"
                android:textColorHint="#64748B"
                android:gravity="center"
                android:layout_marginBottom="8dp" />

            <Button
                android:id="@+id/btn_confirm_pin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Confirmar y Desbloquear"
                android:backgroundTint="#10B981"
                android:textColor="#FFFFFF"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_pin_error"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="PIN incorrecto. Intenta con 1234 o tu código de vinculación."
                android:textColor="#EF4444"
                android:textSize="11sp"
                android:gravity="center"
                android:layout_marginTop="6dp"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Protegido por AppzSegurity Control Parental"
            android:textColor="#64748B"
            android:textSize="10sp"
            android:layout_marginTop="16dp" />

    </LinearLayout>
</ScrollView>
