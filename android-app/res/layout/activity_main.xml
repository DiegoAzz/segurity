<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B0F19"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:gravity="center_horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🛡️"
            android:textSize="44sp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="6dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="AppzSegurity"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Agente Nativo de Control Parental"
            android:textSize="12sp"
            android:textColor="#FFB800"
            android:layout_marginBottom="14dp" />

        <!-- ================= PANTALLA DE BLOQUEO POR PIN PARA PADRES ================= -->
        <LinearLayout
            android:id="@+id/ll_pin_gate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#161F30"
            android:padding="20dp"
            android:gravity="center_horizontal"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔒"
                android:textSize="40sp"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Acceso Protegido por Padres"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="16sp"
                android:layout_marginBottom="6dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Esta aplicación está protegiendo este dispositivo.\nPara ver o modificar la configuración, ingresa el PIN de padres o tu código de vinculación:"
                android:textColor="#94A3B8"
                android:textSize="12sp"
                android:gravity="center"
                android:layout_marginBottom="16dp" />

            <EditText
                android:id="@+id/et_gate_pin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#0B0F19"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold"
                android:padding="12dp"
                android:hint="PIN o Código Familiar"
                android:textColorHint="#64748B"
                android:gravity="center"
                android:inputType="numberPassword"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/tv_gate_error"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="❌ PIN incorrecto. Intenta de nuevo."
                android:textColor="#EF4444"
                android:textStyle="bold"
                android:textSize="12sp"
                android:visibility="gone"
                android:layout_marginBottom="10dp" />

            <Button
                android:id="@+id/btn_unlock_gate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Desbloquear Configuración"
                android:backgroundTint="#FFB800"
                android:textColor="#000000"
                android:textStyle="bold"
                android:textSize="13sp"
                android:layout_marginBottom="8dp" />

            <Button
                android:id="@+id/btn_exit_gate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Cerrar y Salir"
                android:backgroundTint="#334155"
                android:textColor="#FFFFFF"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- ================= CONTENIDO DE CONFIGURACIÓN (SOLO PARA PADRES) ================= -->
        <LinearLayout
            android:id="@+id/ll_main_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#161F30"
                android:textColor="#10B981"
                android:text="● Servicio Conectado a Servidor"
                android:textStyle="bold"
                android:textSize="12sp"
                android:padding="12dp"
                android:layout_marginBottom="14dp" />

            <!-- Tarjeta de Vinculación Familiar -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#161F30"
                android:padding="14dp"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Código de Familia (6 dígitos):"
                    android:textColor="#FFB800"
                    android:textStyle="bold"
                    android:textSize="12sp"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Escribe el código que te dio el administrador o tu panel:"
                    android:textColor="#94A3B8"
                    android:textSize="11sp"
                    android:layout_marginBottom="6dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <EditText
                        android:id="@+id/et_pairing_code"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="#0B0F19"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:padding="10dp"
                        android:text="123456"
                        android:hint="Ej: 123456"
                        android:textColorHint="#64748B"
                        android:gravity="center"
                        android:inputType="number"
                        android:layout_marginEnd="8dp" />

                    <Button
                        android:id="@+id/btn_save_pairing_code"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Guardar"
                        android:backgroundTint="#FFB800"
                        android:textColor="#000000"
                        android:textStyle="bold"
                        android:textSize="12sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tv_child_assigned"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="👦 Hijo asignado: Lucas (Perfil Principal)"
                    android:textColor="#38BDF8"
                    android:textStyle="bold"
                    android:textSize="12sp"
                    android:layout_marginTop="8dp" />

                <Button
                    android:id="@+id/btn_change_child"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Cambiar Hijo Asignado a este Teléfono"
                    android:backgroundTint="#1E293B"
                    android:textColor="#E2E8F0"
                    android:textSize="11sp"
                    android:layout_marginTop="6dp" />
            </LinearLayout>

            <!-- Permisos Esenciales -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="1. Permiso de Superposición (Tapar Apps):"
                android:textColor="#94A3B8"
                android:textSize="11sp"
                android:layout_marginBottom="4dp" />

            <Button
                android:id="@+id/btn_overlay_perm"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Conceder Superposición de Pantalla"
                android:backgroundTint="#FFB800"
                android:textColor="#000000"
                android:textStyle="bold"
                android:textSize="12sp"
                android:layout_marginBottom="12dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="2. Permiso de Accesibilidad (Bloqueo YouTube y Pornografía):"
                android:textColor="#94A3B8"
                android:textSize="11sp"
                android:layout_marginBottom="4dp" />

            <Button
                android:id="@+id/btn_accessibility_perm"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Activar Accesibilidad de AppzSegurity"
                android:backgroundTint="#FFB800"
                android:textColor="#000000"
                android:textStyle="bold"
                android:textSize="12sp"
                android:layout_marginBottom="12dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="3. Ubicación GPS en Vivo:"
                android:textColor="#94A3B8"
                android:textSize="11sp"
                android:layout_marginBottom="4dp" />

            <Button
                android:id="@+id/btn_location_perm"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Permitir Ubicación Todo el Tiempo"
                android:backgroundTint="#10B981"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="12sp"
                android:layout_marginBottom="12dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="4. Inicio Automático y Batería Sin Restricciones:"
                android:textColor="#94A3B8"
                android:textSize="11sp"
                android:layout_marginBottom="4dp" />

            <Button
                android:id="@+id/btn_autostart_perm"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Configurar Inicio Automático (Anti-Reinicio)"
                android:backgroundTint="#2563EB"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="12sp"
                android:layout_marginBottom="4dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="* En Xiaomi / Oppo / Huawei: pon 'Sin restricciones' de batería e 'Inicio automático'."
                android:textColor="#93C5FD"
                android:textSize="12sp"
                android:layout_marginBottom="12dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="5. Protección contra Eliminación (Admin de Dispositivo):"
                android:textColor="#94A3B8"
                android:textSize="11sp"
                android:layout_marginBottom="4dp" />

            <Button
                android:id="@+id/btn_device_admin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Bloquear Desinstalación de la App"
                android:backgroundTint="#334155"
                android:textColor="#F8FAFC"
                android:textStyle="bold"
                android:textSize="12sp"
                android:layout_marginBottom="14dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Dirección del Servidor:"
                android:textColor="#94A3B8"
                android:textSize="11sp"
                android:layout_marginBottom="4dp" />

            <EditText
                android:id="@+id/et_server_url"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#161F30"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:padding="10dp"
                android:text="https://segurity.appzplay.online"
                android:layout_marginBottom="14dp" />

            <Button
                android:id="@+id/btn_test_lock"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Probar Pantalla de Bloqueo (Vista Previa 10s)"
                android:backgroundTint="#EF4444"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:layout_marginBottom="12dp" />

            <!-- BOTONES DE SEGURIDAD PARA PADRES -->
            <Button
                android:id="@+id/btn_lock_settings_now"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🔒 Bloquear Configuración con PIN de Padres"
                android:backgroundTint="#059669"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="13sp"
                android:layout_marginBottom="8dp" />

            <Button
                android:id="@+id/btn_stealth_mode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="👻 Ocultar Icono de la App (Modo Invisible)"
                android:backgroundTint="#475569"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:layout_marginBottom="16dp" />

        </LinearLayout>

    </LinearLayout>
</ScrollView>
